# ---------------------------------------------------------------------------
# Core (required)
# ---------------------------------------------------------------------------

# Postgres (Neon) connection string.
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"
# Public app URL, used by Auth.js.
NEXTAUTH_URL=http://localhost:3000
# JWT signing secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# GitHub OAuth app (callback: <NEXTAUTH_URL>/api/auth/callback/github).
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Primary AI provider.
GEMINI_API_KEY=""
# 64 hex chars for AES-256-GCM encryption of stored secrets: GitHub OAuth tokens, LinkedIn tokens and
# per-repo webhook secrets (required in production). Generate with: openssl rand -hex 32
# After setting it on an existing database, run: pnpm db:encrypt-secrets
OAUTH_TOKEN_ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# App and automation
# ---------------------------------------------------------------------------

# Canonical public origin for emails, approval links and OAuth redirects. Falls back to NEXTAUTH_URL, then https://$VERCEL_URL.
APP_URL=""
# Bearer secret for /api/cron/* (required in production). Vercel Cron sends "Authorization: Bearer $CRON_SECRET".
# Schedules (vercel.json): /api/cron/publish every 10 minutes, /api/cron/autopilot hourly. Sub-daily crons need
# Vercel Pro; on Hobby, call both URLs from an external scheduler (Upstash QStash, cron-job.org) with that header.
CRON_SECRET=""
# Public origin GitHub calls for webhooks. Defaults to APP_URL; use a tunnel (smee.io, ngrok) in local dev.
WEBHOOK_BASE_URL=""
# Rate limits are shared across serverless instances through the rate_limit_buckets table. Set to "memory"
# to keep them per instance (local tinkering without the 0007 migration).
RATE_LIMIT_STORE=""

# ---------------------------------------------------------------------------
# Email (optional; when unset, emails are logged to the console)
# ---------------------------------------------------------------------------

# Resend API key for real email delivery.
RESEND_API_KEY=""
# Sender address. Default: CommitFlex <onboarding@resend.dev>
EMAIL_FROM="CommitFlex <onboarding@resend.dev>"
# Public support address shown on /terms, /privacy and (Team) /billing. Falls back to the EMAIL_FROM address unless that is @resend.dev.
SUPPORT_EMAIL=""

# ---------------------------------------------------------------------------
# LinkedIn publishing (optional; when unset, LinkedIn posts use the one-tap handoff)
# ---------------------------------------------------------------------------

# LinkedIn app with "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn". Redirect: <APP_URL>/api/integrations/linkedin/callback
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# LinkedIn-Version header for the Posts API (YYYYMM). Default: 202510
LINKEDIN_API_VERSION=""

# ---------------------------------------------------------------------------
# AI fallback (optional)
# ---------------------------------------------------------------------------

# Fallback provider: when the primary provider errors, the request is retried once on the other one if its key is set.
ANTHROPIC_API_KEY=""
# gemini (default) or anthropic.
AI_PROVIDER=""
# Claude model used when Anthropic serves a request. Default: claude-opus-5-5
ANTHROPIC_MODEL=""

# ---------------------------------------------------------------------------
# Billing: Razorpay (optional; when unset, checkout returns 503 not_configured)
# ---------------------------------------------------------------------------

# API keys from Razorpay Dashboard > Account & Settings > API Keys.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Secret set on the webhook pointing at <APP_URL>/api/webhooks/razorpay. Subscribe it to subscription.activated, charged, pending, halted, cancelled, completed, paused and resumed.
RAZORPAY_WEBHOOK_SECRET=""
# Plan IDs (plan_...) created in the dashboard. Pro: INR 499 / 4,990, USD 9 / 90. Team: INR 1,999 / 19,990, USD 29 / 290.
RAZORPAY_PLAN_PRO_MONTHLY_INR=""
RAZORPAY_PLAN_PRO_YEARLY_INR=""
RAZORPAY_PLAN_PRO_MONTHLY_USD=""
RAZORPAY_PLAN_PRO_YEARLY_USD=""
RAZORPAY_PLAN_TEAM_MONTHLY_INR=""
RAZORPAY_PLAN_TEAM_YEARLY_INR=""
RAZORPAY_PLAN_TEAM_MONTHLY_USD=""
RAZORPAY_PLAN_TEAM_YEARLY_USD=""

# ---------------------------------------------------------------------------
# Chrome extension (optional)
# ---------------------------------------------------------------------------

# Chrome Web Store listing. When unset, /extension offers the early-access zip (/extension/download) that
# `pnpm build` packs into public/commitflex-extension.zip, and Today hides the extension setup step.
NEXT_PUBLIC_CHROME_EXTENSION_URL=""
# Build-time only (read by extension/build.mjs, not the app): comma-separated CommitFlex origins the extension
# talks to; the first is its default. Defaults to APP_URL, then https://$VERCEL_PROJECT_PRODUCTION_URL, then
# http://localhost:3000.
# COMMITFLEX_APP_URL=https://your-domain.example
